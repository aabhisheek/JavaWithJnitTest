# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=productdb
DB_USERNAME=postgres
DB_PASSWORD=changeme_strong_password

# ── Redis (access-token blacklist) ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=           # leave blank for no-auth Redis in local dev

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 256 bits (32+ characters). Generate with:
#   openssl rand -hex 64
JWT_SECRET=replace_with_a_very_long_random_secret_at_least_256_bits_long!!
JWT_ACCESS_EXPIRY=900000       # 15 minutes in ms
JWT_REFRESH_EXPIRY=604800000   # 7 days in ms

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
